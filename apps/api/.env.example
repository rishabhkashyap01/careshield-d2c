# Copy to .env and adjust. Matches docker-compose.yml at the repo root.
DATABASE_URL="postgresql://careshield:careshield@localhost:5432/careshield?schema=public"
PORT=4000

# Comma-separated origins allowed to call the API (the Next.js app)
WEB_ORIGIN="http://localhost:3000"

# Simulated payment-gateway latency in ms (mock gateway only)
MOCK_PAYMENT_LATENCY_MS=400
