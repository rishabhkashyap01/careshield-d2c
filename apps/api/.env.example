# Copy to .env and adjust. Matches docker-compose.yml at the repo root.
DATABASE_URL="postgresql://careshield:careshield@localhost:5432/careshield?schema=public"
PORT=4000

# Simulated payment-gateway latency in ms (mock gateway only)
MOCK_PAYMENT_LATENCY_MS=400

# Fail DB connections after this many ms instead of hanging (unreachable host)
DB_CONNECT_TIMEOUT_MS=5000
# Max database connections per instance (use a small number, e.g. 3, on serverless)
DB_POOL_MAX=10
# /health/ready reports "timeout" if SELECT 1 takes longer than this
HEALTH_DB_TIMEOUT_MS=2000
